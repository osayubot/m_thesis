{
  "latex-workshop.latex.recipes": [
    {
      "name": "uplatex → dvipdfmx",
      "tools": ["uplatex", "uplatex", "dvipdfmx"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "uplatex",
      "command": "uplatex",
      "args": ["-interaction=nonstopmode", "-file-line-error", "%DOC%"]
    },
    {
      "name": "dvipdfmx",
      "command": "dvipdfmx",
      "args": ["%DOCFILE%.dvi"]
    }
  ]
}
